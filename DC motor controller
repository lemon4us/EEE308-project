#include <16F877A.h>
#device ADC=10
#fuses HS,NOWDT,NOPROTECT,NOLVP
#use delay(clock=8000000)
#use fast_io(B)
#use fast_io(C)


unsigned int16 i;
int8 dir = 0; 

void main() {
   port_b_pullups(TRUE);               
   output_b(0);                        
   set_tris_b(0x07);                   
   output_c(0);                        
   set_tris_c(0);                      
   
   setup_adc(ADC_CLOCK_DIV_32);        
   setup_adc_ports(AN0);               
   set_adc_channel(0);                 
   
   setup_timer_2(T2_DIV_BY_16, 255, 1); 
   delay_ms(100);

   while(TRUE) {
      i = read_adc();                  
      

      if(dir == 1) {                   
         set_pwm1_duty(i);             
         output_low(PIN_C1);           
      }
      else if(dir == 2) {              
         set_pwm2_duty(i);            
         output_low(PIN_C2);           
      }

   
      if(input(PIN_B0) == 0) {
         if(dir != 1) {
            dir = 0;                  
            setup_ccp1(CCP_OFF);
            setup_ccp2(CCP_OFF);
            output_c(0);
            output_b(0);
            delay_ms(100);             
            
            setup_ccp1(CCP_PWM);       
            output_high(PIN_B3);       
            dir = 1;
         }
      }

     
      if(input(PIN_B1) == 0) {
         if(dir != 2) {
            dir = 0;                   
            setup_ccp1(CCP_OFF);
            setup_ccp2(CCP_OFF);
            output_c(0);
            output_b(0);
            delay_ms(100);
            
            setup_ccp2(CCP_PWM);       
            output_high(PIN_B4);      
            dir = 2;
         }
      }

   
      if(input(PIN_B2) == 0) {
         dir = 0;
         setup_ccp1(CCP_OFF);
         setup_ccp2(CCP_OFF);
         output_low(PIN_C1);
         output_low(PIN_C2);
         output_b(0);
      }
      
      delay_ms(10); 
   }
}
